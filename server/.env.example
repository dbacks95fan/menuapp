# Copy to .env for local runs. All values are optional; defaults shown.

# development | test | production
NODE_ENV=development

# HTTP port for the API + SPA (1-65535)
PORT=4000

# SQLite file path. Default: ./data/mealflow.db (":memory:" under NODE_ENV=test)
SQLITE_PATH=./data/mealflow.db

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for the normal single-origin deployment. Only needed if the client
# is served from a different origin than the API (a split dev setup).
CORS_ORIGINS=

# pino log level: fatal | error | warn | info | debug | trace | silent
# Default: info (silent under NODE_ENV=test)
LOG_LEVEL=info
