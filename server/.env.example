# Copy to .env for local runs. All values are optional; defaults shown.

# development | test | production
NODE_ENV=development

# HTTP port for the API + SPA (1-65535)
PORT=4000

# SQLite file path. Default: ./data/mealflow.db (":memory:" under NODE_ENV=test)
SQLITE_PATH=./data/mealflow.db

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for the normal single-origin deployment. Only needed if the client
# is served from a different origin than the API (a split dev setup).
CORS_ORIGINS=

# pino log level: fatal | error | warn | info | debug | trace | silent
# Default: info (silent under NODE_ENV=test)
LOG_LEVEL=info

# --- Fry's / Kroger integration (optional; features are inert until all three
#     of KEY + CLIENT_ID + CLIENT_SECRET are set). Never commit real values. ---
# 32+ byte key (hex/base64/utf8) used to encrypt the stored Fry's token at rest.
MEALFLOW_SECRET_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Override only for testing against a mock; defaults to the real API.
KROGER_API_BASE=https://api.kroger.com/v1
# Must exactly match the redirect URI registered in the Kroger app config.
KROGER_REDIRECT_URI=http://localhost:4000/api/frys/callback
